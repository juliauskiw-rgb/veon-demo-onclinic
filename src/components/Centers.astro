---
// Centers directory (concept 8.2 #8): 11 rows, the chosen city first and marked (city.ts). Mykolaiv has two addresses.
import { cities, phones, cityTags } from "../data/site";
---
<section id="centers" class="centers section" aria-labelledby="centers-title">
  <div class="container">
    <div class="section__head">
      <h2 id="centers-title" class="section__title">Центри в 11 містах</h2>
      <p class="section__lead">Адреси і безкоштовні лінії 0 800. Місто, яке ви обрали, стоїть першим.</p>
    </div>
    <ul class="centers__list" data-centers>
      {cities.map((c, i) => (
        <li class="center" data-center={c.id} data-order={i} data-reveal style={`--reveal-delay:${Math.min(i, 6) * 40}ms`}>
          <h3 class="center__city">{c.name}</h3>
          <div class="center__addr">{c.addresses.map((a) => <p>{a}</p>)}</div>
          <ul class="center__tags" aria-label="Що є в центрі">{cityTags(c).map((t) => <li>{t}</li>)}</ul>
          <a class="center__phone num" href={phones[c.phone].tel}>{phones[c.phone].display}</a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .centers { background: var(--color-well); }
  .centers__list { border-block-start: 1px solid var(--color-rule); }
  .center { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap); align-items: baseline; padding: var(--space-5) var(--space-3); border-block-end: 1px solid var(--color-rule); }
  .center.is-current { background: var(--color-bg); border-radius: var(--radius); box-shadow: inset 4px 0 0 var(--color-field); }
  .center__city { grid-column: 1 / span 3; font-size: var(--text-title); line-height: 1.15; letter-spacing: -0.01em; }
  .center__addr { grid-column: 4 / span 4; display: grid; gap: var(--space-1); }
  .center__tags { grid-column: 8 / span 3; display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .center__tags li { padding: 2px var(--space-2); border: 1px solid var(--color-rule); border-radius: var(--radius); font-size: var(--text-small); color: var(--color-muted); }
  .center__phone { grid-column: 11 / span 2; justify-self: end; display: inline-flex; align-items: center; min-height: 44px; font-weight: 600; color: var(--color-link); white-space: nowrap; text-underline-offset: 4px; }
  @media (hover: hover) { .center__phone:hover { text-decoration-thickness: 2px; } }

  @media (max-width: 75rem) {
    .center__city { grid-column: 1 / span 3; }
    .center__addr { grid-column: 4 / span 4; }
    .center__tags { grid-column: 8 / span 2; }
    .center__phone { grid-column: 10 / span 3; }
  }
  @media (max-width: 60rem) {
    .center { grid-template-columns: minmax(0, 1fr) auto; row-gap: var(--space-2); }
    .center__city { grid-column: 1; }
    .center__phone { grid-column: 2; grid-row: 1; }
    .center__addr, .center__tags { grid-column: 1 / -1; }
  }
</style>
