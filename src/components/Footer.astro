---
// Footer (concept 5, «Футер»): ink field, the five 0 800 lines signed with their cities (C-010), bots, legal line (C-002).
// Instagram, Facebook, YouTube — status confirmed in client.json (SMM import 2026-11-10).
import FutureLink from "./FutureLink.astro";
import Icon from "./Icon.astro";
import { phones, phoneOrder, bots, note } from "../data/site";
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---
<footer id="footer" class="footer on-ink">
  <div class="footer__in container">
    <div class="footer__brand">
      <a class="footer__logo" href="#top" aria-label="ОН Клінік, на початок сторінки">
        <img src={`${base}img/logo-onclinic.svg`} width="112" height="40" alt="" />
      </a>
      <p>Мережа медичних центрів ОН Клінік</p>
      <p class="footer__bots">
        <a href={bots.telegram}><Icon name="telegram" />Telegram-бот</a>
      </p>
      <p class="footer__bots footer__social">
        <a href="https://www.instagram.com/onclinic.ua/" rel="noopener">Instagram</a>
        <a href="https://www.facebook.com/onclinic.ua" rel="noopener">Facebook</a>
        <a href="https://www.youtube.com/channel/UCh45BrzHzY3dkb7VZpJAbpw" rel="noopener">YouTube</a>
      </p>
    </div>

    <div class="footer__lines">
      <h2 class="footer__title">Лінії 0 800 за містами</h2>
      <ul>
        {phoneOrder.map((id) => phones[id]).map((p) => (
          <li>
            <a class="footer__phone num" href={p.tel}>{p.display}</a>
            <span class="footer__cities">{p.cities}</span>
          </li>
        ))}
      </ul>
      <p class="footer__free">Дзвінки на лінії 0 800 безкоштовні.</p>
    </div>

    <div class="footer__base">
      <p>MEDICAL ADVANCED LLC, 2007–2026. Лабораторія: ТОВ «ОН ЛАБ».</p>
      <ul class="footer__links">
        <li><FutureLink note={note}>Про нас</FutureLink></li>
        <li><FutureLink note={note}>Блог</FutureLink></li>
        <li><FutureLink note={note}>Політика конфіденційності</FutureLink></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .footer { background: var(--color-text); color: var(--color-on-field); padding-block: var(--space-8) var(--space-6); }
  .footer__in { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap); row-gap: var(--space-7); }
  .footer__brand { grid-column: 1 / span 4; display: grid; gap: var(--space-4); align-content: start; }
  .footer__logo { display: inline-flex; min-height: 44px; align-items: center; justify-self: start; }
  .footer__logo img { width: 112px; height: 40px; }
  .footer__bots { display: flex; flex-wrap: wrap; column-gap: var(--space-5); }
  .footer__bots a { display: inline-flex; align-items: center; gap: var(--space-2); min-height: 44px; font-weight: 600; white-space: nowrap; text-underline-offset: 4px; }
  .footer__lines { grid-column: 6 / -1; display: grid; gap: var(--space-4); }
  .footer__title { font-size: var(--text-title); line-height: 1.15; }
  .footer__lines ul { border-block-start: 1px solid var(--color-rule-on-ink); }
  .footer__lines li { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); gap: var(--space-4); align-items: baseline; padding-block: var(--space-3); border-block-end: 1px solid var(--color-rule-on-ink); }
  .footer__phone { display: inline-flex; align-items: center; min-height: 44px; font-family: var(--font-display); font-weight: 300; font-size: var(--text-lead); color: var(--color-accent); text-decoration: none; white-space: nowrap; }
  @media (hover: hover) { .footer__phone:hover { text-decoration: underline; text-underline-offset: 5px; } }
  .footer__free { font-size: var(--text-small); }
  .footer__base { grid-column: 1 / -1; display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-4); padding-block-start: var(--space-5); border-block-start: 1px solid var(--color-rule-on-ink); font-size: var(--text-small); }
  .footer__links { display: flex; flex-wrap: wrap; column-gap: var(--space-5); row-gap: var(--space-2); }
  .footer__links :global(.future-link) { min-height: 44px; white-space: nowrap; }
  .footer__links :global(.future-link__note) { background: var(--color-bg); color: var(--color-text); top: auto; bottom: calc(100% + var(--space-1)); }

  @media (max-width: 60rem) {
    .footer { padding-block: var(--space-7) calc(var(--space-6) + var(--bar-h)); }
    .footer__in { grid-template-columns: minmax(0, 1fr); }
    .footer__brand, .footer__lines, .footer__base { grid-column: 1 / -1; }
  }
  @media (max-width: 40rem) {
    .footer__lines li { grid-template-columns: minmax(0, 1fr); gap: 0; }
  }
</style>
