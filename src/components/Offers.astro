---
// Offers (concept 8.2 #6): dated rows, not banners. Only offers valid on the build date (C-017, home-desktop-fold.png).
import FutureLink from "./FutureLink.astro";
import { offers, phones, note } from "../data/site";
---
<section id="offers" class="offers section" aria-labelledby="offers-title">
  <div class="offers__in container">
    <div class="offers__head">
      <h2 id="offers-title" class="section__title">Акції цього місяця</h2>
      <FutureLink note={note} class="offers__all">Усі акції та новини</FutureLink>
    </div>
    <ul class="offers__list">
      {offers.map((o, i) => (
        <li class="offer" data-reveal style={`--reveal-delay:${i * 40}ms`}>
          <p class="offer__city">{o.city}</p>
          <h3 class="offer__title">{o.title}</h3>
          <div class="offer__foot">
            <p class="offer__date">Діє з <time datetime={o.fromIso}>{o.from}</time> до <time datetime={o.toIso}>{o.to}</time></p>
            <a class="text-link offer__call num" href={phones[o.phone].tel}>Лінія: {phones[o.phone].display}</a>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .offers__head { display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-5); margin-block-end: var(--space-6); }
  .offers__head :global(.offers__all) { min-height: 44px; font-weight: 600; white-space: nowrap; }
  .offers__list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--gap); }
  .offer { display: grid; grid-template-rows: auto 1fr auto; gap: var(--space-4); padding: var(--space-6); border-block-start: 4px solid var(--color-field); background: var(--color-well); border-radius: 0 0 var(--radius-card) var(--radius-card); }
  .offer__city { justify-self: start; padding: var(--space-1) var(--space-3); border-radius: var(--radius); background: var(--color-field); color: var(--color-on-field); font-weight: 600; font-size: var(--text-small); }
  .offer__title { font-size: var(--text-title); line-height: 1.2; letter-spacing: -0.01em; max-width: 24ch; }
  .offer__foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-3); padding-block-start: var(--space-4); border-block-start: 1px solid var(--color-rule); }
  .offer__date { color: var(--color-muted); font-size: var(--text-small); }
  .offer__call { white-space: nowrap; min-height: 44px; display: inline-flex; align-items: center; font-weight: 600; }

  @media (max-width: 60rem) {
    .offers__head { flex-wrap: wrap; }
    .offers__list { grid-template-columns: minmax(0, 1fr); }
    .offer { padding: var(--space-5); }
  }
</style>
