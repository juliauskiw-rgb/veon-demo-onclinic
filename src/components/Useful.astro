---
// «Корисне» (concept 8.2 #7): a text list; every item is a future page (C-018, home-desktop-s06.png).
import FutureLink from "./FutureLink.astro";
import { articles, note } from "../data/site";
---
<section id="useful" class="useful section" aria-labelledby="useful-title">
  <div class="useful__in container">
    <h2 id="useful-title" class="section__title useful__title">Корисне</h2>
    <ul class="useful__list">
      <li class="useful__item">
        <h3 class="useful__name"><FutureLink note={note}>Підготовка до досліджень</FutureLink></h3>
        <p class="useful__meta">Розділ для пацієнтів</p>
      </li>
      <li class="useful__item">
        <h3 class="useful__name"><FutureLink note={note}>Питання-відповіді</FutureLink></h3>
        <p class="useful__meta">Розділ для пацієнтів</p>
      </li>
      {articles.map((a) => (
        <li class="useful__item">
          <h3 class="useful__name"><FutureLink note={note}>{a.title}</FutureLink></h3>
          <p class="useful__meta">Стаття в блозі. Автор: {a.author}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .useful { border-block-start: 1px solid var(--color-rule); }
  .useful__in { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap); row-gap: var(--space-6); }
  .useful__title { grid-column: 1 / span 4; }
  .useful__list { grid-column: 5 / -1; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--gap); border-block-start: 1px solid var(--color-rule); }
  .useful__item { display: grid; align-content: start; gap: var(--space-2); padding-block: var(--space-5); border-block-end: 1px solid var(--color-rule); }
  .useful__name { font-family: var(--font-body); font-size: var(--text-lead); font-weight: 600; line-height: 1.35; }
  .useful__name :global(.future-link) { display: inline; }
  .useful__name :global(.future-link__note) { left: 0; transform: translate(0, -4px); }
  .useful__name :global(.future-link:hover .future-link__note), .useful__name :global(.future-link:focus-visible .future-link__note) { transform: none; }
  .useful__meta { color: var(--color-muted); font-size: var(--text-small); }

  @media (max-width: 60rem) {
    .useful__in { grid-template-columns: minmax(0, 1fr); }
    .useful__title, .useful__list { grid-column: 1 / -1; }
    .useful__list { grid-template-columns: minmax(0, 1fr); }
  }
</style>
