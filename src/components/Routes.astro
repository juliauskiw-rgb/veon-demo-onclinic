---
// «З чим звертаєтесь» (concept 8.2 #2): a typographic index of 7 rows, each a <details> with the real list
// and an action. Replaces the four carousels of the current homepage (R-109); one main action per row (R-105).
import FutureLink from "./FutureLink.astro";
import Icon from "./Icon.astro";
import { phones, generalPhone, kidsCities, kharkiv, bots, note, noteForm } from "../data/site";

const p = phones[generalPhone];
const kh = phones[kharkiv.phone];
---
<section id="routes" class="routes section" data-rec="R-105,R-109" aria-labelledby="routes-title">
  <div class="routes__in container">
    <div class="routes__aside">
      <h2 id="routes-title" class="section__title">З чим звертаєтесь</h2>
      <p class="routes__lead">Відкрийте рядок: що є в мережі і куди дзвонити.</p>
      <p class="routes__phone">
        <span class="routes__phone-label">Лінія: <span data-city-label data-empty="загальна">загальна</span></span>
        <a class="routes__phone-num num" href={p.tel} data-phone><span data-phone-text>{p.display}</span></a>
      </p>
    </div>

    <div class="routes__list">
      <details class="route">
        <summary><h3 class="route__title">Лікар за напрямом</h3><Icon name="chevron" class="route__chev" /></summary>
        <div class="route__body">
          <p>Амбулаторний прийом лікарів різних спеціальностей у центрах для дорослих.</p>
          <ul class="route__items">
            <li>Гінекологія</li><li>Урологія</li><li>Проктологія</li><li>Хірургія</li><li>Дерматологія</li>
            <li>Кардіологія</li><li>Неврологія</li><li>Гастроентерологія</li><li>Алергологія</li><li>Офтальмологія</li>
          </ul>
          <p class="route__actions">
            <a class="text-link num" href={p.tel} data-phone>Подзвонити: <span data-phone-text>{p.display}</span></a>
            <FutureLink note={note}>Усі 38 відділень</FutureLink>
          </p>
        </div>
      </details>

      <details class="route">
        <summary><h3 class="route__title">Дитячий центр</h3><Icon name="chevron" class="route__chev" /></summary>
        <div class="route__body">
          <p>Дитячі центри ОН Клінік працюють у шести містах:</p>
          <ul class="route__items">{kidsCities.map((c) => <li>{c}</li>)}</ul>
          <p class="route__actions">
            <a class="text-link num" href={p.tel} data-phone>Подзвонити: <span data-phone-text>{p.display}</span></a>
            <FutureLink note={note}>Дитячі центри</FutureLink>
          </p>
        </div>
      </details>

      <details class="route">
        <summary><h3 class="route__title">Діагностика</h3><Icon name="chevron" class="route__chev" /></summary>
        <div class="route__body">
          <p>Які методи є саме у вашому центрі, підкаже адміністратор.</p>
          <ul class="route__items">
            <li>Ендоскопія</li><li>УЗД</li><li>Функціональна діагностика</li><li>Рентген</li><li>КТ</li><li>МРТ</li>
          </ul>
          <p class="route__actions">
            <a class="text-link num" href={p.tel} data-phone>Подзвонити: <span data-phone-text>{p.display}</span></a>
            <FutureLink note={note}>Підготовка до досліджень</FutureLink>
          </p>
        </div>
      </details>

      <details class="route">
        <summary><h3 class="route__title">Аналізи ОН ЛАБ</h3><Icon name="chevron" class="route__chev" /></summary>
        <div class="route__body">
          <p>Власна лабораторія мережі, ТОВ «ОН ЛАБ».</p>
          <p class="route__actions">
            <a class="text-link num" href={p.tel} data-phone>Подзвонити: <span data-phone-text>{p.display}</span></a>
            <FutureLink note={note}>Аналізи для пацієнтів</FutureLink>
          </p>
        </div>
      </details>

      <details class="route">
        <summary><h3 class="route__title">Онлайн-консультація</h3><Icon name="chevron" class="route__chev" /></summary>
        <div class="route__body">
          <p>Онлайн-консультації профільних лікарів по відеозв’язку, без візиту до центру.</p>
          <p class="route__actions">
            <a class="text-link" href={bots.telegram}>Написати в Telegram</a>
            <FutureLink note={noteForm}>Запис на відеоконсультацію</FutureLink>
          </p>
        </div>
      </details>

      <details class="route">
        <summary><h3 class="route__title">Хірургія і стаціонар (Харків)</h3><Icon name="chevron" class="route__chev" /></summary>
        <div class="route__body">
          <p>Центр у Харкові приймає пацієнтів з інших міст.</p>
          <ul class="route__items"><li>Операційний блок</li><li>Реабілітаційне відділення</li><li>Денний стаціонар</li></ul>
          <p class="route__actions">
            <a class="text-link num" href={kh.tel}>Лінія Харкова: {kh.display}</a>
            <FutureLink note={note}>Хірургія і стаціонар</FutureLink>
          </p>
        </div>
      </details>

      <details class="route route--urgent">
        <summary><h3 class="route__title">Швидка допомога (Харків)</h3><Icon name="chevron" class="route__chev" /></summary>
        <div class="route__body">
          <p>Швидка допомога ОН Клінік працює в Харкові.</p>
          <p class="route__actions">
            <a class="btn btn--outline-light num" href={kh.tel}><Icon name="phone" />Лінія Харкова: {kh.display}</a>
          </p>
        </div>
      </details>
    </div>
  </div>
</section>

<style>
  .routes__in { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap); row-gap: var(--space-6); align-items: start; }
  .routes__aside { grid-column: 1 / span 4; position: sticky; top: calc(var(--header-h) + var(--space-6)); display: grid; gap: var(--space-4); }
  .routes__lead { font-size: var(--text-lead); color: var(--color-muted); }
  .routes__phone { display: grid; gap: var(--space-1); padding-block-start: var(--space-4); border-block-start: 1px solid var(--color-rule); }
  .routes__phone-label { font-size: var(--text-small); color: var(--color-muted); }
  .routes__phone-num { justify-self: start; font-family: var(--font-display); font-weight: 300; font-size: var(--text-title); color: var(--color-text); text-decoration: none; white-space: nowrap; }
  @media (hover: hover) { .routes__phone-num:hover { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 5px; } }

  .routes__list { grid-column: 5 / -1; border-block-start: 1px solid var(--color-rule); }
  .route { border-block-end: 1px solid var(--color-rule); }
  .route summary { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); min-height: 88px; padding: var(--space-4) var(--space-3); cursor: pointer; list-style: none; border-radius: var(--radius); transition: background-color var(--dur-micro) var(--ease-out); }
  .route summary::-webkit-details-marker { display: none; }
  .route__title { font-size: var(--text-title); line-height: 1.15; letter-spacing: -0.01em; }
  .route :global(.route__chev) { width: 28px; height: 28px; transition: transform var(--dur-short) var(--ease-in-out); }
  .route[open] :global(.route__chev) { transform: rotate(180deg); }
  @media (hover: hover) { .route summary:hover { background: var(--color-well); } }

  .route__body { display: grid; gap: var(--space-4); padding: 0 var(--space-3) var(--space-6); max-width: 52rem; }
  .route__items { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .route__items li { padding: var(--space-1) var(--space-3); border: 1px solid var(--color-rule); border-radius: var(--radius); font-size: var(--text-small); }
  .route__actions { display: flex; flex-wrap: wrap; align-items: center; column-gap: var(--space-5); row-gap: var(--space-2); }
  .route__actions > :global(*) { min-height: 44px; display: inline-flex; align-items: center; white-space: nowrap; }

  .route--urgent { background: var(--color-text); color: var(--color-on-field); border-radius: var(--radius); border-block-end-color: transparent; margin-block-start: var(--space-2); padding-block-end: var(--space-1); }
  .route--urgent :focus-visible { outline-color: var(--color-focus-on-field); }
  .route--urgent .route__items li { border-color: var(--color-rule-on-ink); }
  @media (hover: hover) { .route--urgent summary:hover { background: var(--color-rule-on-ink); } }

  /* Effect 3: the row opens in place */
  @keyframes route-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  .route[open] .route__body { animation: route-in var(--dur-short) var(--ease-out); }

  @media (max-width: 60rem) {
    .routes__in { grid-template-columns: minmax(0, 1fr); }
    .routes__aside, .routes__list { grid-column: 1 / -1; }
    .routes__aside { position: static; }
    .route summary { min-height: 72px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .route[open] .route__body { animation: none; }
    .route :global(.route__chev) { transition: none; }
  }
</style>
