---
// First screen (concept 5, «Перший екран»): blue field, H1 + one sentence, the selected city card, the index of 11 cities.
import Icon from "./Icon.astro";
import { cities, phones, generalPhone, bots, cityNote } from "../data/site";

const p = phones[generalPhone];
---
<section id="hero" class="hero on-field" data-rec="R-101" aria-labelledby="hero-title">
  <div class="hero__in container">
    <div class="hero__text">
      <h1 id="hero-title" class="hero__title" data-rec="R-301,R-401">Медичні центри ОН&nbsp;Клінік в 11 містах України</h1>
      <p class="hero__lead">Понад 20 центрів для дорослих і дітей. Оберіть місто, і ми покажемо адресу та безкоштовну лінію вашого центру.</p>
    </div>

    <div class="card" data-rec="R-102,R-105">
      <div class="card__live" data-swap aria-live="polite" aria-atomic="true">
        <p class="card__title" data-card-title data-empty="Загальна лінія ОН Клінік">Загальна лінія ОН Клінік</p>
        <a class="card__phone num" href={p.tel} data-phone><span data-phone-text>{p.display}</span></a>
        <p class="card__hint" data-card-hint>Оберіть місто нижче, щоб побачити номер і адресу свого центру.</p>
        <div class="card__place" data-card-place hidden>
          <p class="card__address" data-card-address></p>
          <ul class="card__tags" data-card-tags aria-label="Що є в центрі"></ul>
        </div>
      </div>
      <div class="card__actions">
        <a class="btn btn--primary card__call" href={p.tel} data-phone data-rec="R-402"><Icon name="phone" />Подзвонити</a>
        <a class="btn btn--outline" href="#how">Записатися</a>
      </div>
      <p class="card__bots">
        <a class="text-link" href={bots.telegram}>Telegram-бот</a>
        <span class="card__bots-note">оператори 24/7</span>
      </p>
    </div>

    <div class="index" id="cities" role="group" aria-labelledby="cities-label" data-rec="R-104">
      <p class="index__label" id="cities-label">Оберіть місто</p>
      <ul class="index__list">
        {cities.map((c, i) => (
          <li style={`--i:${i}`}>
            <button class="index__btn" type="button" data-city-btn={c.id} aria-pressed="false">
              <span class="index__name">{c.name}</span>
              <span class="index__note">{cityNote(c)}</span>
            </button>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .hero { background: var(--color-field); color: var(--color-on-field); padding-block: var(--space-7) var(--space-6); }
  .hero__in { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap); row-gap: var(--space-6); align-items: start; }
  .hero__text { grid-column: 1 / span 8; display: grid; gap: var(--space-5); padding-block-start: var(--space-4); }
  .hero__title { font-size: var(--text-h1); line-height: 1.04; letter-spacing: -0.02em; }
  .hero__lead { font-size: var(--text-lead); max-width: 36rem; }

  .card { grid-column: 9 / span 4; display: grid; gap: var(--space-5); padding: var(--space-6); background: var(--color-bg); color: var(--color-text); border-radius: var(--radius-card); }
  .card__live { display: grid; gap: var(--space-2); }
  .card__title { font-weight: 600; }
  .card__phone { justify-self: start; font-family: var(--font-display); font-weight: 300; font-size: var(--text-phone); line-height: 1.1; letter-spacing: -0.01em; color: var(--color-text); text-decoration: none; white-space: nowrap; }
  @media (hover: hover) { .card__phone:hover { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 6px; } }
  .card__hint { color: var(--color-muted); font-size: var(--text-small); }
  .card__place { display: grid; gap: var(--space-3); }
  .card__place[hidden] { display: none; }
  .card__address { font-size: var(--text-body); }
  .card__tags { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .card__tags :global(li) { padding: var(--space-1) var(--space-3); border-radius: var(--radius); background: var(--color-well); font-size: var(--text-small); }
  .card__actions { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .card__bots { display: flex; flex-wrap: wrap; align-items: center; column-gap: var(--space-4); row-gap: var(--space-2); font-size: var(--text-small); }
  .card__bots a { display: inline-flex; align-items: center; min-height: 44px; white-space: nowrap; }
  .card__bots-note { color: var(--color-muted); }
  .card :focus-visible { outline-color: var(--color-focus); }

  .index { grid-column: 1 / -1; display: grid; gap: var(--space-3); }
  .index__label { font-size: var(--text-small); font-weight: 600; }
  .index__list { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); column-gap: var(--gap); }
  .index__btn { display: grid; grid-template-rows: auto 1.45em; justify-items: start; align-content: center; white-space: nowrap; gap: var(--space-1); width: 100%; min-height: 76px; padding: var(--space-2) var(--space-3); border: 0; border-block-start: 1px solid var(--color-rule-on-field); border-radius: 0; background: transparent; color: var(--color-on-field); text-align: start; cursor: pointer; transition: background-color var(--dur-micro) var(--ease-out), color var(--dur-micro) var(--ease-out); }
  .index__name { font-family: var(--font-display); font-weight: 300; font-size: min(var(--text-index), 2.55vw); line-height: 1.05; letter-spacing: -0.01em; white-space: nowrap; }
  .index__note { font-size: var(--text-small); line-height: 1.45; white-space: nowrap; }
  .index__btn[aria-pressed="true"] { background: var(--color-on-field); color: var(--color-text); border-radius: var(--radius); }
  .index__btn[aria-pressed="true"] .index__name { font-weight: 600; }
  .index__btn:focus-visible { outline: 2px solid var(--color-focus-on-field); outline-offset: 2px; }
  @media (hover: hover) { .index__btn:hover:not([aria-pressed="true"]) { background: var(--color-field-hover); } }
  .index__btn:active { transform: scale(.98); }

  /* Effect 1: the index appears (CSS only, content stays visible without scripts) */
  @keyframes index-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  .index__list li { animation: index-in 500ms var(--ease-out) both; animation-delay: calc(var(--i) * 35ms); }

  @media (max-width: 75rem) {
    .hero__text { grid-column: 1 / span 7; }
    .card { grid-column: 8 / span 5; padding: var(--space-5); }
  }
  @media (max-width: 60rem) {
    .hero { padding-block: var(--space-6); }
    .hero__in { grid-template-columns: minmax(0, 1fr); row-gap: var(--space-5); }
    .hero__text, .card, .index { grid-column: 1 / -1; }
    .hero__text { padding: 0; gap: var(--space-4); }
    .hero__title { line-height: 1.08; max-width: none; }
    .card { order: 2; }
    .index { order: 3; }
    .index__list { display: flex; flex-wrap: wrap; gap: var(--space-2); }
    .index__btn { grid-template-rows: auto; justify-items: center; min-height: 44px; padding: 0 var(--space-3); border: 1.5px solid var(--color-rule-on-field); border-radius: var(--radius); }
    .index__name { font-family: var(--font-body); font-weight: 600; font-size: var(--text-small); letter-spacing: 0; }
    .index__note { display: none; }
    .index__list li { animation-duration: 300ms; animation-delay: 0ms; }
    .card__actions { display: grid; }
    .card__actions .btn { width: 100%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .index__list li { animation: none; }
    .index__btn:active { transform: none; }
  }
</style>
