---
// Functional line icons only (concept 5, «Зображення»): phone, Telegram, Viber, search, cabinet, chevron, menu.
interface Props { name: "phone" | "telegram" | "viber" | "search" | "user" | "chevron" | "menu" | "close"; class?: string; }
const { name, class: cls } = Astro.props;
---
<svg class:list={["icon", cls]} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {name === "phone" && <path d="M5.5 3.5h3l1.5 4-2 1.5a11 11 0 0 0 7 7l1.5-2 4 1.5v3a2 2 0 0 1-2 2A16 16 0 0 1 3.5 5.5a2 2 0 0 1 2-2Z" />}
  {name === "telegram" && <path d="M20.5 4 3.5 10.8l5.6 2 2 6.2 3.1-3.7 4.6 3.3L20.5 4Zm-11.4 8.8 8-5.3-5.9 6.6" />}
  {name === "viber" && <><path d="M12 3.5c4.7 0 8 2.6 8 7.2s-3.3 7-8 7c-.8 0-1.6-.1-2.3-.2L6.5 20v-3.4C4.6 15.4 4 13.5 4 10.7 4 6.1 7.3 3.5 12 3.5Z" /><path d="M9.6 8.2c.4 2.6 2.1 4.4 4.7 5" /><path d="M12.6 7.6a2.6 2.6 0 0 1 2.3 2.3" /></>}
  {name === "search" && <><circle cx="11" cy="11" r="6.5" /><path d="m16 16 4.5 4.5" /></>}
  {name === "user" && <><circle cx="12" cy="8.5" r="4" /><path d="M4.5 20.5a7.5 7.5 0 0 1 15 0" /></>}
  {name === "chevron" && <path d="m6 9 6 6 6-6" />}
  {name === "menu" && <path d="M4 7h16M4 12h16M4 17h16" />}
  {name === "close" && <path d="m6 6 12 12M18 6 6 18" />}
</svg>
